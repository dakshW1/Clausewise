# Copy to .env and fill in. Without keys, Clausewise runs in demo mode with the sample agreement.
GEMINI_API_KEY=
# Check the exact Gemma 4 model id in Google AI Studio and change it here if needed.
GEMMA_MODEL=gemma-4-31b-it
SARVAM_API_KEY=
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_TRANSLATE_MODEL=mayura:v1
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_SPEAKER=priya
